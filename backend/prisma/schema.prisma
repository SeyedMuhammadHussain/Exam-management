generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  student
}

enum ExamStatus {
  active
  inactive
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

model User {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String   @unique
  password  String
  role      Role     @default(student)
  grade     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  exams     Exam[]
  attempts  ExamAttempt[]
  @@index([role])
  @@map("users")
}
model Exam {
  id           String     @id @default(uuid())
  title        String
  description  String     @default("")
  duration     Int
  totalMarks   Int        @map("total_marks")
  passingMarks Int        @map("passing_marks")
  startTime    DateTime   @map("start_time")
  endTime      DateTime   @map("end_time")
  status       ExamStatus @default(active)
  createdBy    String?    @map("created_by")
  creator      User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  questions    Question[]
  attempts     ExamAttempt[]
  @@index([status, startTime, endTime])
  @@map("exams")
}
model Question {
  id        String   @id @default(uuid())
  examId    String   @map("exam_id")
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text      String   @map("question_text")
  marks     Int
  createdAt DateTime @default(now()) @map("created_at")
  options   Option[]
  answers   StudentAnswer[]
  @@index([examId])
  @@map("questions")
}
model Option {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @map("option_text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  @@unique([questionId, position])
  @@map("options")
}
model ExamAttempt {
  id            String        @id @default(uuid())
  studentId     String        @map("student_id")
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId        String        @map("exam_id")
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  startTime     DateTime      @default(now()) @map("start_time")
  endTime       DateTime      @map("end_time")
  submittedAt   DateTime?     @map("submitted_at")
  obtainedMarks Int?          @map("obtained_marks")
  totalMarks    Int?          @map("total_marks")
  percentage    Float?
  passed        Boolean?
  status        AttemptStatus @default(in_progress)
  createdAt     DateTime      @default(now()) @map("created_at")
  answers       StudentAnswer[]
  @@unique([studentId, examId])
  @@index([examId])
  @@index([status, endTime])
  @@map("exam_attempts")
}
model StudentAnswer {
  id               String      @id @default(uuid())
  attemptId        String      @map("attempt_id")
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String      @map("question_id")
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?     @map("selected_option_id")
  isCorrect        Boolean     @default(false) @map("is_correct")
  marksObtained    Int         @default(0) @map("marks_obtained")
  @@unique([attemptId, questionId])
  @@map("student_answers")
}
