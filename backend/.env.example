NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/exam_db?schema=public"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
TRUST_PROXY=0
# Seeding (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@school.edu
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO=true
SEED_DEMO_PASSWORD=change-me-student-password
